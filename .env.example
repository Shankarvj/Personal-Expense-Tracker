# ========================================================
# Personal Expense Tracker - Environment Configuration Template
# ========================================================

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expenseTracker?retryWrites=true&w=majority

# JSON Web Token (JWT) Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

